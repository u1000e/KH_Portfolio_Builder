# ============================================================================
# application.yml 템플릿 (키 이름만 — 실제 값/시크릿은 커밋하지 않는다)
# ----------------------------------------------------------------------------
# 사용법:
#   1) 이 파일을 같은 위치에 application.yml 로 복사한다 (application.yml 은 .gitignore 대상).
#   2) 아래 ${...} 에 대응하는 값을 "환경변수 / 로컬 .env / SSM Parameter Store" 로 주입한다.
#   3) 시크릿 실제 값은 코드/깃에 절대 넣지 않는다.
#
# 주입이 필요한 환경변수:
#   DB_USER, DB_PASSWORD,
#   OPENAI_API_KEY,
#   GITHUB_OAUTH_CLIENT_ID, GITHUB_OAUTH_CLIENT_SECRET, GITHUB_OAUTH_REDIRECT_URI(선택),
#   JWT_SECRET(Base64 인코딩 32바이트=256비트 이상),
#   REDIS_HOST/REDIS_PORT(선택)
# AWS 자격증명:
#   정적 키를 넣지 않는다. 기본 자격증명 체인(로컬 AWS 프로파일 / EC2 인스턴스 역할)에서 자동 획득.
# ============================================================================

server:
  port: 8081

spring:
  datasource:
    # 로컬은 SSM 포트포워딩(localhost:15432), 운영은 RDS 엔드포인트로 교체
    url: jdbc:postgresql://localhost:15432/mydb?sslmode=require
    username: ${DB_USER}
    password: ${DB_PASSWORD}
  ai:
    openai:
      api-key: ${OPENAI_API_KEY}
      chat:
        options:
          model: gpt-4o-mini
          temperature: 0.3
  jpa:
    hibernate:
      ddl-auto: validate      # 최초 빈 DB에 스키마를 만들 때만 일시적으로 update
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
  security:
    oauth2:
      client:
        registration:
          github:
            client-id: ${GITHUB_OAUTH_CLIENT_ID}
            client-secret: ${GITHUB_OAUTH_CLIENT_SECRET}
            scope: user:email,read:user

jwt:
  secret: ${JWT_SECRET}
  expiration: 86400000 # 24시간

app:
  frontend:
    url: http://localhost:5173
  quiz:
    auto-seed: true         # 빈 DB 자동 시딩 스위치. 운영은 @Profile("!prod")로 이미 차단됨.

# GitHub OAuth (AuthService 실사용 경로)
github:
  client:
    id: ${GITHUB_OAUTH_CLIENT_ID}
    secret: ${GITHUB_OAUTH_CLIENT_SECRET}
  redirect:
    uri: ${GITHUB_OAUTH_REDIRECT_URI:http://localhost:5173/auth/callback}

# AWS S3 (자격증명은 기본 자격증명 체인, 정적 키 미사용)
aws:
  region: ap-northeast-2
  s3:
    bucket: kh-501

# Redis
spring.data:
  redis:
    host: ${REDIS_HOST:localhost}
    port: ${REDIS_PORT:6379}

# Rate Limiting
rate-limit:
  evaluate:
    daily-limit: 3
  til-booster:
    daily-limit: 10
